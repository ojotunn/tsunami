# RPC própria (Alchemy, QuickNode, dwellir...) — recomendada em produção
PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Banco local do indexador
PONS_DB=./data/pons.sqlite

# Diretório dos keystores dos agentes (permissão 0600 por arquivo)
PONS_KEYSTORE_DIR=./data/keystores

# Senha do keystore em modo não interativo. Evite em produção.
# PONS_PASSWORD=

# Taxa de serviço do operador. Sem PONS_FEE_ADDRESS não há cobrança nenhuma.
# Cobrada em ETH nas compras e na coleta de rewards; airdrop e saque nunca pagam.
# PONS_FEE_ADDRESS=0x...
# PONS_FEE_BPS=500          # 500 = 5% · teto 1000 (10%)

# Tesouraria: a taxa vira recompra e queima do token da casa, sem clique.
# 1) crie um agente no app e aponte-o para o token a queimar; 2) coloque a
# carteira dele em PONS_FEE_ADDRESS; 3) preencha os dois abaixo e reinicie.
# O servidor reescreve a politica desse agente (modo automatico, sem teto) e
# liga o buyback & burn em "gastar o saldo inteiro" a cada boot.
# PONS_TREASURY_AGENT=<id ou endereco do agente>
# PONS_TREASURY_PASSWORD=<senha do keystore desse agente>
# PONS_TREASURY_INTERVAL_MIN=30   # de quanto em quanto tempo o laco roda
# PONS_TREASURY_MIN_ETH=0.005     # so compra quando juntar isto (alem da reserva de gas)

# pons v2 (bonding curve + Uniswap V4). Defaults are the live mainnet addresses
# from docs.ponsfamily.com/docs/v2; override only if pons rolls out a new stack.
# PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# PONS_V2_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# PONS_V2_MEME_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
